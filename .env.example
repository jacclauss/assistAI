# Copy to .env and fill in. .env is gitignored and must never be committed.

# Fireworks AI inference credential.
FIREWORKS_API_KEY=fw_...

# Optional overrides. Defaults are fine for local development.
# ASSISTAI_MANIFEST_PATH=manifest.toml
# ASSISTAI_AGENTS_CONFIG=config/assistai.toml
# ASSISTAI_MAX_TOKENS=2048
# ASSISTAI_MAX_TOOL_ROUNDS=4
# ASSISTAI_TEMPERATURE=0.2
# ASSISTAI_MAX_CONCURRENT_TURNS=4

# Log verbosity: debug | info | warning | error
ASSISTAI_LOG_LEVEL=info

# Human-readable console logs instead of JSON. Useful on the Mac, off on the Pi.
ASSISTAI_LOG_CONSOLE=false

# Seconds between gateway heartbeat log lines.
ASSISTAI_HEARTBEAT_SECONDS=60

# Seconds a channel gets to drain after SIGTERM. Keep it under the runtime's
# kill grace (Docker defaults to 10) or the process is killed, not stopped.
ASSISTAI_SHUTDOWN_GRACE_SECONDS=5

# Signal. Leave SIGNAL_ACCOUNT unset to run without the channel (chat still works).
# Dedicated bot number, never a personal one: signal-cli ignores messages from
# its own account, so a personal number cannot text its own assistant.
# ASSISTAI_SIGNAL_ACCOUNT=+15555550100
# Comma-separated E.164 numbers. These are the operators: they may talk to the
# bot. Unknown numbers get silence. Set DM_POLICY=pairing if a stranger should
# receive a code you can approve with /approve NNNNNN from an operator phone.
# A number admitted by pairing can never approve anyone else.
# ASSISTAI_SIGNAL_ALLOW_FROM=+15555550101
# ASSISTAI_SIGNAL_DM_POLICY=allowlist
# ASSISTAI_SIGNAL_BASE_URL=http://signal-cli:8080
# Host-mode against `make up-dev` (loopback only):
# ASSISTAI_SIGNAL_BASE_URL=http://127.0.0.1:8080
# ASSISTAI_STATE_DIR=state

# Spend and abuse limits. Inference is metered, so these are the guardrails on
# what one sender can cost you per minute.
# ASSISTAI_SIGNAL_RATE_LIMIT_PER_MINUTE=12
# ASSISTAI_SIGNAL_MAX_INBOUND_CHARS=4000
# ASSISTAI_SIGNAL_PAIRING_REPLIES_PER_HOUR=3
# Seconds to wait for signal-cli to finish booting before giving up.
# ASSISTAI_SIGNAL_STARTUP_TIMEOUT_SECONDS=120
